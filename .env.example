# Freshdesk subdomain only: "acme" for acme.freshdesk.com
FRESHDESK_DOMAIN=acme

# Profile Settings -> Your API Key in Freshdesk.
# Used as the basic-auth username. Never passed as a tool argument and never
# reaches the model's context.
FRESHDESK_API_KEY=replace-me

# Used in logs to attribute calls. One connector process serves one merchant.
MERCHANT_ID=acme

# Your Freshdesk plan's per-minute API ceiling. The connector stays under this
# rather than discovering it by being throttled.
FRESHDESK_RATE_LIMIT_PER_MINUTE=50

MAX_CONCURRENCY=4
MAX_RESPONSE_CHARS=12000

# Leave false. There is no customer-facing write tool in this build; the flag
# exists so that adding one later is a deliberate, reviewable act.
ALLOW_CUSTOMER_FACING_WRITES=false
