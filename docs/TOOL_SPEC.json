{
  "tools": [
    {
      "name": "list_tickets",
      "title": "List tickets",
      "description": "List tickets in recency order, optionally filtered by status, priority or last-updated time. Returns compact summaries with a short preview, not full conversation history. Freshdesk only returns tickets updated in the last 30 days unless updated_since is set — pass it explicitly for anything older. Use this to scan a queue; use get_ticket_thread once you have narrowed to a specific ticket.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "pending",
              "resolved",
              "closed"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ]
          },
          "updated_since": {
            "type": "string",
            "format": "date-time"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "cursor": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "search_tickets",
      "title": "Search tickets",
      "description": "Server-side search across the whole helpdesk by status, priority, tag, type or creation window. Prefer this over list_tickets when you know what you are looking for. Freshdesk's search index caps results at roughly 300 (30 per page, 10 pages) and does not do free-text search over message bodies — narrow with filters, do not paginate hoping for more.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "open",
              "pending",
              "resolved",
              "closed"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ]
          },
          "tag": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "created_after": {
            "type": "string",
            "format": "date-time"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "get_ticket_thread",
      "title": "Get one ticket with its conversation",
      "description": "Fetch a single ticket with its message thread, oldest first, as plain text. Freshdesk embeds at most the 10 most recent messages; thread_complete tells you whether older messages exist beyond what is returned. This is the expensive call — use it on the handful of tickets you have already narrowed to.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "integer",
            "minimum": 0
          },
          "max_messages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 12
          },
          "max_chars_per_message": {
            "type": "integer",
            "minimum": 200,
            "maximum": 8000,
            "default": 1500
          },
          "include_contact": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "ticket_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "add_private_note",
      "title": "Add an internal note",
      "description": "Attach an internal note to a ticket. The customer never sees it. This is the agent's default way to record a finding, a draft reply for a human to send, or a recommended action. Idempotent: pass a stable idempotency_key and a retry will not create a duplicate.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "integer",
            "minimum": 0
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "Stable key for this logical note, e.g. 'triage-<ticket_id>-<run_id>'."
          }
        },
        "required": [
          "ticket_id",
          "body",
          "idempotency_key"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true
      }
    },
    {
      "name": "update_ticket",
      "title": "Update ticket state",
      "description": "Change a ticket's status, priority or tags. This is visible in the merchant's helpdesk and in their SLA reporting, so it is gated on human approval by default. It cannot send anything to the customer — there is no tool in this connector that can.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "pending",
              "resolved",
              "closed"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ]
          },
          "add_tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "description": "Why this change is correct. Written to the audit log and shown to the approver."
          }
        },
        "required": [
          "ticket_id",
          "idempotency_key",
          "reason"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false
      }
    }
  ]
}